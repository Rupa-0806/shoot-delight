# Server
PORT=5000
NODE_ENV=development
CLIENT_URL=http://localhost:5173

# Database (Supabase PostgreSQL connection string)
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/postgres?schema=public"

# JWT
JWT_SECRET=replace_with_a_long_random_secret
JWT_EXPIRES_IN=7d

# Email (choose ONE provider)
EMAIL_PROVIDER=nodemailer            # "nodemailer" or "resend"

# --- Nodemailer (SMTP) ---
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=shootdelight678@gmail.com
SMTP_PASS=your_16_char_gmail_app_password

# --- Resend (alternative) ---
RESEND_API_KEY=

# Business notification email (where booking alerts + payment screenshots are sent)
BUSINESS_EMAIL=shootdelight678@gmail.com
FROM_EMAIL="Shoot Delight <shootdelight678@gmail.com>"

# UPI / payment number shown to customers after booking (displayed on the frontend too)
PAYMENT_NUMBER=8919080514

# Admin seed (used by prisma/seed.js)
SEED_ADMIN_NAME="Shoot Delight Admin"
SEED_ADMIN_EMAIL=admin@shootdelight.com
SEED_ADMIN_PASSWORD=ChangeMe123!
